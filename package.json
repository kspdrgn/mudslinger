{
  "name": "mudslinger",
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "watch": {
    "build-client": {
      "patterns": [
        "ts"
      ],
      "extensions": "ts",
      "quiet": false
    },
    "start": "{ts}/*.js"
  },
  "scripts": {
    "prestart": "node tools/prestart.js",
    "start": "npm run node-setup && npm run prestart && npm run build && npm run start-server",
    "start-server": "node dist/server/app.js",
    "postinstall": "node tools/postinstall.js",
    "clean": "rimraf ts/build && rimraf dist && rimraf static/mudslinger.js",
    "build": "npm run build-client && npm run build-server",
    "build-client": "tsc -p ts/tsconfig.client.json && rollup -c ts/rollup.config.js",
    "build-server": "tsc -p ts/tsconfig.server.json",
    "lint": "tslint -c ts/tslint.json ts/src/client/*.ts && tslint -c ts/tslint.json ts/src/server/*.ts",
    "lint-fix": "tslint --fix -c ts/tslint.json ts/src/client/*.ts && tslint --fix -c ts/tslint.json ts/src/server/*.ts",
    "node-setup": "node -v && npm -v && npm install",
    "watch": "npm-watch"
  },
  "dependencies": {
    "codemirror": "^5.65.18",
    "express": "^5.0.1",
    "jquery": "3.7.1",
    "jqwidgets-framework": "^22.0.2",
    "socket.io": "^1.7.2",
    "socket.io-client": "^1.7.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/jquery": "^3.5.32",
    "@types/node": "20.17.17",
    "@types/socket.io": "^1.4.27",
    "@types/socket.io-client": "^1.4.29",
    "fs-extra": "^11.3.0",
    "npm-watch": "^0.13.0",
    "rimraf": "^6.0.1",
    "rollup": "^0.68.2",
    "tslint": "^6.1.3",
    "typescript": "^5.7.3"
  }
}
